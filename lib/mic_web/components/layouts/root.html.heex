<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title>
      <%= assigns[:page_title] || "Incurator" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js">
    </script>
  </head>
  <body class="bg-[#1A237E] text-white antialiased flex flex-col min-h-screen">
    <div class="flex-grow bg-gradient-to-b from-[#1A237E] to-[#3949AB] bg-opacity-80 backdrop-filter backdrop-blur-sm">
      <nav class="bg-white bg-opacity-10 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between h-16">
            <div class="flex items-center">
              <a href="/" class="flex-shrink-0">
                <img class="h-12 w-12" src="/images/logo.svg" alt="Incurator" />
              </a>
            </div>
            <div class="flex items-center">
              <ul class="flex items-center space-x-4">
                <%= if @current_user do %>
                  <li class="text-sm">
                    <%= @current_user.email %>
                  </li>
                  <li>
                    <.link
                      href={~p"/users/settings"}
                      class="text-sm font-medium hover:text-yellow-400 transition-colors duration-200"
                    >
                      Settings
                    </.link>
                  </li>
                  <li>
                    <.link
                      href={~p"/users/log_out"}
                      method="delete"
                      class="text-sm font-medium hover:text-yellow-400 transition-colors duration-200"
                    >
                      Log Out
                    </.link>
                  </li>
                <% else %>
                  <li>
                    <.link
                      href={~p"/users/register"}
                      class="text-sm font-medium hover:text-yellow-400 transition-colors duration-200"
                    >
                      Register
                    </.link>
                  </li>
                  <li>
                    <.link
                      href={~p"/users/log_in"}
                      class="text-sm font-medium hover:text-yellow-400 transition-colors duration-200"
                    >
                      Log in
                    </.link>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </nav>

      <main class="container mx-auto mt-8 px-4 sm:px-6 lg:px-8 flex-grow">
        <%= @inner_content %>
      </main>
    </div>

    <footer class="bg-white bg-opacity-10 mt-auto">
      <div class="max-w-7xl mx-auto py-4 px-4 sm:px-6 lg:px-8">
        <p class="text-center text-sm">© 2023 Incurator. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
