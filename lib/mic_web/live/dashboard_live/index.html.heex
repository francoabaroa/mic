<section class="px-4 py-8 sm:px-6 lg:px-8">
  <div class="container mx-auto">
    <h1 class="text-center text-lg font-semibold leading-8">
      Artist Career Metrics
    </h1>
    <span class="block text-center mb-4">Caution: Mock Data</span>
    <!-- Responsive grid container -->
    <%!-- TODO: fix small charts in large view, due to app.html.heex, how can we avoid this? also, ignore? --%>
    <div class="grid grid-cols-1 gap-8" id="ignore_dashboard" phx-update="ignore">
      <div class="w-full">
        <canvas id="listenersChart" phx-hook="ListenersChart"></canvas>
        <button
          class="mt-2 flex justify-center items-center bg-blue-500 text-white p-2 rounded hover:bg-blue-700 w-full"
          phx-click="nextListeners"
        >
          Refresh Listeners
        </button>
      </div>
      <div class="w-full">
        <canvas id="likesChart" phx-hook="LikesChart"></canvas>
        <button
          class="mt-2 flex justify-center items-center bg-blue-500 text-white p-2 rounded hover:bg-blue-700 w-full"
          phx-click="nextLikes"
        >
          Refresh Likes
        </button>
      </div>
      <div class="w-full">
        <canvas id="commentsChart" phx-hook="CommentsChart"></canvas>
        <button
          class="mt-2 flex justify-center items-center bg-blue-500 text-white p-2 rounded hover:bg-blue-700 w-full"
          phx-click="nextComments"
        >
          Refresh Comments
        </button>
      </div>
    </div>
  </div>
</section>
