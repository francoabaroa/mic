<div id="chatgpt" class="flex flex-col h-screen rounded-lg" phx-hook="VoiceAudioHandlers">
  <%= if @profile_generating do %>
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
      <div class="bg-white bg-opacity-10 backdrop-blur-md rounded-lg p-8 flex flex-col items-center">
        <div class="animate-spin rounded-full h-16 w-16 border-t-2 border-b-2 border-yellow-400">
        </div>
        <p class="mt-4 text-white font-semibold">Generating your profile...</p>
      </div>
    </div>
  <% end %>

  <div class="flex-grow overflow-y-auto px-4 py-6">
    <div class="max-w-3xl mx-auto">
      <.live_component
        module={MicWeb.MessageListComponent}
        messages={@messages ++ [@streaming_message]}
        assistant_scenario_id={@assistant_scenario_id}
        language_preference={@language_preference}
        id="myid"
      />

      <%= if Phoenix.Flash.get(@flash, :error) do %>
        <div class="mb-4">
          <AlertComponent.render text={Phoenix.Flash.get(@flash, :error)} />
        </div>
      <% end %>

      <%= if @loading do %>
        <div class="flex justify-center items-center py-4">
          <div class="animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-yellow-400">
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-white bg-opacity-10 backdrop-blur-md border-t border-white border-opacity-20 px-4 py-4">
    <div class="max-w-3xl mx-auto">
      <.live_component
        on_submit={fn val -> Process.send(self(), {:msg_submit, val, false, nil}, []) end}
        module={MicWeb.TextboxComponent}
        assistant_scenario_id={@assistant_scenario_id}
        current_question={@current_question || true}
        uploads={@uploads}
        text={@text}
        disabled={@loading}
        id="textbox"
      />
    </div>
  </div>
</div>
