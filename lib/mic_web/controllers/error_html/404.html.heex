<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <.live_title>
      <%= assigns[:page_title] || "Incurator" %>
    </.live_title>
    <link rel="stylesheet" href="/assets/app.css" />
    <script defer type="text/javascript" src="/assets/app.js">
    </script>
  </head>
  <body>
    <header class="px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
        <div class="flex items-center gap-4">
          <a href="/">
            <img src={~p"/images/logo.svg"} width="48" />
          </a>
        </div>
      </div>
    </header>
    <main class="container">
      <section class="phx-hero">
        <div class="pl-8 pt-8">
          <p class="text-xl mb-4">The page you are looking for does not exist.</p>
          <p class="text-lg">
            <a href="/" class="text-blue-500 hover:text-blue-700 underline">Go home</a>
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
