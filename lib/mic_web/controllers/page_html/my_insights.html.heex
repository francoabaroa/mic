<.flash_group flash={@flash} />
<%= if @current_user do %>
  <section class="px-4 py-8 sm:px-6 sm:py-8 lg:px-8 xl:px-8 xl:py-8">
    <div class="mx-auto max-w-xl lg:mx-0">
      <h1 class="text-brand mt-10 mb-4 flex items-center text-lg font-semibold leading-6">
        <%= if @user_settings.response_language == :spanish do %>
          Perspectivas
        <% else %>
          <%= if @user_settings.response_language == :portuguese do %>
            Perspectivas
          <% else %>
            Insights
          <% end %>
        <% end %>
      </h1>

      <%= if @personalized_resources == "" do %>
        <p>No personalized content available. Check back later.</p>
      <% else %>
        <%= Phoenix.HTML.raw(@personalized_resources) %>
      <% end %>
    </div>
  </section>
<% else %>
  <section class="px-4 py-10 sm:px-6 sm:py-28 lg:px-8 xl:px-28 xl:py-32">
    <!-- TODO: Add content for guests goes here -->
  <!-- Include a brief about the artist development program to entice new users to join -->
    <div class="mx-auto max-w-xl lg:mx-0">
      <h1 class="text-brand mt-10 flex items-center text-lg font-semibold leading-6">
        Sign up today to get access!
      </h1>
    </div>
  </section>
<% end %>
